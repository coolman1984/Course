<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AI_Academy</AssemblyName>
    <RootNamespace>AIAcademy</RootNamespace>
    <Product>AI Academy</Product>
    <AssemblyTitle>AI Academy</AssemblyTitle>
    <Description>AI Essentials for the Modern Workplace — interactive course</Description>
    <Company>AI Academy</Company>
    <Copyright>© 2026 AI Academy</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>AI_Academy.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- one self-contained exe: no .NET install needed on the learner's PC -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- payload.bin and Key.g.cs are produced by build.ps1 (encrypted course + PDF) -->
  <ItemGroup>
    <EmbeddedResource Include="obj\payload\*.bin" LogicalName="%(Filename)" />
    <EmbeddedResource Include="AI_Academy.ico" LogicalName="app.ico" />
    <Compile Include="obj\payload\Key.g.cs" />
  </ItemGroup>

</Project>
